# Firestore project. For local work this is any non-empty string.
FIREBASE_PROJECT_ID=cartly-dev

# --- Local development: Firestore emulator ---
# When this is set, the Admin SDK talks to the emulator and needs no credentials.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- Real Firebase project ---
# Comment out FIRESTORE_EMULATOR_HOST above, set FIREBASE_PROJECT_ID to your
# project ID, and point this at your downloaded service account key.
# Never commit the key itself.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Port the NestJS API listens on.
PORT=3000
